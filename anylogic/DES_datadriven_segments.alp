					<Name><![CDATA[delay2]]></Name>
					<X>320</X><Y>1050</Y>
					<Label><X>0</X><Y>-10</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<ActiveObjectClass>
						<PackageName><![CDATA[com.anylogic.libraries.processmodeling]]></PackageName>
						<ClassName><![CDATA[Delay]]></ClassName>
					</ActiveObjectClass>
					<GenericParameterSubstitute>
						<GenericParameterSubstituteReference>
							<PackageName><![CDATA[com.anylogic.libraries.processmodeling]]></PackageName>
							<ClassName><![CDATA[Delay]]></ClassName>
							<ItemName><![CDATA[1412336242930]]></ItemName>
						</GenericParameterSubstituteReference>
					</GenericParameterSubstitute>
					<Parameters>
						<Parameter>
							<Name><![CDATA[type]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[delayTime]]></Name>
							<Value Class="CodeUnitValue">
								<Code><![CDATA[uniform(8, 17)]]></Code>
								<Unit Class="TimeUnits"><![CDATA[HOUR]]></Unit>
							</Value>
						</Parameter>
						<Parameter>
							<Name><![CDATA[capacity]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[99999]]></Code>
							</Value>
						</Parameter>
						<Parameter>
							<Name><![CDATA[maximumCapacity]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[true]]></Code>
							</Value>
						</Parameter>
						<Parameter>
							<Name><![CDATA[entityLocation]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[pushProtocol]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[restoreEntityLocationOnExit]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[forceStatisticsCollection]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onEnter]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onAtExit]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onExit]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[// SEGMENT-AWARE consumption: pick the shelf by product type (A=fresh, B=dry, C=frozen).
// Per customer: Bernoulli(pFIFO) -> take 1 unit from the OLDEST (FIFO) or NEWEST (LIFO) batch,
// exactly as in the ALNS (R,S) simulation. Expiry is handled in the 05:00 daily event (A only).
dailyDemand d = (dailyDemand) agent;
Store targetStore = stores.get(d.storeID);

List<ProductUnit> stockList = "A".equals(d.productType) ? targetStore.stockA
                            : "B".equals(d.productType) ? targetStore.stockB
                                                        : targetStore.stockC;
boolean served = false;
if (stockList != null && !stockList.isEmpty()) {
    int idx = (uniform() < pFIFO) ? 0 : stockList.size() - 1;   // 0.70 FIFO oldest / 0.30 LIFO newest
    stockList.remove(idx);
    served = true;
    targetStore.servedDemandTotal += 1;
    if ("A".equals(d.productType))      targetStore.servedDemandA += 1;
    else if ("B".equals(d.productType)) targetStore.servedDemandB += 1;
    else                                targetStore.servedDemandC += 1;
}
if (!served) {
    targetStore.lostDemandTotal += 1;
    if ("A".equals(d.productType))      targetStore.lostDemandA += 1;
    else if ("B".equals(d.productType)) targetStore.lostDemandB += 1;
    else                                targetStore.lostDemandC += 1;
}]]></Code>
							</Value>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onRemove]]></Name>
						</Parameter>
					</Parameters>
