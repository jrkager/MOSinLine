import java.util.stream.Collectors;]]></Import>
			<StartupCode><![CDATA[// 1) StoreID assignment
for (int i = 0; i < stores.size(); i++) {
    stores.get(i).storeID = i;
}

// 2) Warehouse assignment (First 8 → W0, Rest 3 → W1)
for (int i = 0; i < stores.size(); i++) {
    stores.get(i).assignedWarehouse = warehouses.get(0);
}

// 3) Read capa and R from Excel
{
    final int N = stores.size();
    maxCapByStoreProduct = new int[N][3];
    maxCapByStoreTotal   = new int[N];
    // rpByStoreProduct burada da doldurulacak
    rpByStoreProduct     = new int[N][3];

    boolean[] seen = new boolean[N];

    int row = 2; 

    while (excelCapFile.cellExists("A" + row)) {
        int id   = (int) excelCapFile.getCellNumericValue("A" + row);
        int capA = (int) excelCapFile.getCellNumericValue("B" + row);
        int capB = (int) excelCapFile.getCellNumericValue("C" + row);
        int capC = (int) excelCapFile.getCellNumericValue("D" + row);

        int capT;
        if (!excelCapFile.cellExists("E" + row)) {
            capT = capA + capB + capC;
        } else {
            capT = (int) excelCapFile.getCellNumericValue("E" + row);
        }

        // If R columns are absent then calculate 0,1*capa
        int rA = excelCapFile.cellExists("F" + row)
            ? (int) excelCapFile.getCellNumericValue("F" + row)
            : (int) Math.round(capA * 0.10);
        int rB = excelCapFile.cellExists("G" + row)
            ? (int) excelCapFile.getCellNumericValue("G" + row)
            : (int) Math.round(capB * 0.10);
        int rC = excelCapFile.cellExists("H" + row)
            ? (int) excelCapFile.getCellNumericValue("H" + row)
            : (int) Math.round(capC * 0.10);

        if (id < 0 || id >= N)
            throw new IllegalStateException("StoreID " + id + " aralık dışı (0.." + (N - 1) + ")");
        if (capA < 0 || capB < 0 || capC < 0 || capT < 0)
            throw new IllegalStateException("Negatif kapasite (StoreID=" + id + ")");
        if (capT < capA + capB + capC)
            throw new IllegalStateException("CapTotal < CapA+CapB+CapC (StoreID=" + id + ")");

        // Safe R: set betwenn [0, cap-1] 
        rA = Math.max(0, Math.min(rA, Math.max(0, capA - 1)));
        rB = Math.max(0, Math.min(rB, Math.max(0, capB - 1)));
        rC = Math.max(0, Math.min(rC, Math.max(0, capC - 1)));

        maxCapByStoreProduct[id][0] = capA;
        maxCapByStoreProduct[id][1] = capB;
        maxCapByStoreProduct[id][2] = capC;
        maxCapByStoreTotal[id]      = capT;

        rpByStoreProduct[id][0] = rA;
        rpByStoreProduct[id][1] = rB;
        rpByStoreProduct[id][2] = rC;

        traceln(
          "StoreID=" + id +
          " | CapA=" + capA + " CapB=" + capB + " CapC=" + capC + " CapTotal=" + capT +
          " || R_A=" + rA + " R_B=" + rB + " R_C=" + rC
        );

        seen[id] = true;
        row++;
    }

    for (int i = 0; i < N; i++) {
        if (!seen[i]) throw new IllegalStateException("StoreID " + i + " için satır yok");
    }

    traceln("Capacities + R loaded from ExcelFile (UI-linked .xlsx)");
}



// 5) Titles of result files
writeToCSV(
  "TruckID;Dispatch Date;Distance (km);Units;Weight (kg);Fuel Cost (eur);Total CO2 Emissions (g);Travel Time (min);Store List;Original Route;Additional Route",
  "trucks.csv"
);

if (!stockHeaderWritten) {
    writeToCSV(
        "Time;Day;StoreID;ProductType;StockLevel;StockoutOccurred;PendingOrderExists;NextDeliveryDay;UrgencyScore",
        "StockLevelReport.csv"
    );
    stockHeaderWritten = true;
}

// ====== AUTO-GENERATED from ALNS solution: R101_50stores_s3 ======
// Paste into Main -> Agent actions -> 'On startup', replacing the
// original route/lambda/position initialisation blocks.
// KM_PER_PX must be set to 0.1 in Main parameters.

// ---- 1) Agent positions (DES km == ALNS km under KM_PER_PX above) ----
warehouses.get(0).setXY(350.0, 320.0);
// ====== DATA-DRIVEN LOAD: reads stores_<name>.csv + routes_<name>.csv ======
// To run a different instance, change _name to "s1" .. "s20". CSV files come from build_anylogic_excel.py.
String _dir  = "D:/PhD/Delivery Pattern Planning/anylogic_excel/";   // folder with the csv files (use forward slashes)
// configId >= 0 : run THAT single config (0..159).  configId < 0 : SWEEP MODE
// SWEEP MODE: read the next config number from _sweepCounter.txt, run it, write next number back.
// -> just click Run 160 times; it auto-advances 0,1,2,...,159. Delete _sweepCounter.txt to restart at 0.
int _cfg = configId;
if (configId < 0) {
    int _ctr = 0;
    try {
        java.io.BufferedReader _br = new java.io.BufferedReader(new java.io.FileReader(_dir + "_sweepCounter.txt"));
        String _ln = _br.readLine(); _br.close();
        if (_ln != null && _ln.trim().length() > 0) _ctr = Integer.parseInt(_ln.trim());
    } catch (Exception _e) { _ctr = 0; }
    _cfg = ((_ctr % 160) + 160) % 160;
    try {
        java.io.FileWriter _fw = new java.io.FileWriter(_dir + "_sweepCounter.txt", false);
        _fw.write(String.valueOf((_cfg + 1) % 160)); _fw.close();
    } catch (Exception _e2) {}
}
int    _mode = _cfg % 8;   // 0=V2 as-is, 1=V1 all rules, 2=V3 drop+cancel, 3=V4 drop+cancel+piggy(skipped),
                           // 4=V5 drop only, 5=V6 cancel only, 6=V7 piggy(all) only, 7=V8 drop+piggy(skipped)
String _name = "s" + (_cfg / 8 + 1);      // s1 .. s20  (160 configs total)
int[] _vnum = {2, 1, 3, 4, 5, 6, 7, 8};
ProductUnit.dropActive   = (_mode==1 || _mode==2 || _mode==3 || _mode==4 || _mode==7);
ProductUnit.cancelActive = (_mode==1 || _mode==2 || _mode==3 || _mode==5);
// piggybackVersion: 0 = none, 1 = urgency top-up over all eligible stores, 4 = skipped-only
piggybackVersion      = (_mode==1 || _mode==6) ? 1 : (_mode==3 || _mode==7) ? 4 : 0;
enableDynamicDispatch = ProductUnit.dropActive || ProductUnit.cancelActive || piggybackVersion > 0;
outSuffix             = "_" + _name + "_variant" + _vnum[_mode];
traceln("=== config " + _cfg + " -> " + _name + " / Variant" + _vnum[_mode]
        + (configId < 0 ? ("  [SWEEP] next run = config " + ((_cfg+1)%160)) : "  [single]") + " ===");
outDir                = _dir;   // write outputs into the SAME folder as the input csv files
int _N = stores.size();
double[][] _xy = new double[_N][2];
double[][] muA = new double[_N][6];   // fresh  (product A, SL=4)
double[][] muB = new double[_N][6];   // dry    (product B, no expiry)
double[][] muC = new double[_N][6];   // frozen (product C, no expiry)
double[][] _S  = new double[_N][3];   // order-up-to S per product [A,B,C]
int[]      _g  = new int[_N];
int[]      _rA = new int[_N];
int[][]    _pdq = new int[_N][6];
try (java.io.BufferedReader _br = new java.io.BufferedReader(new java.io.FileReader(_dir + "stores_" + _name + ".csv"))) {
    _br.readLine();
    String _ln;
    while ((_ln = _br.readLine()) != null) {
        if (_ln.trim().isEmpty()) continue;
        String[] _c = _ln.split(",");
        int _i = Integer.parseInt(_c[0].trim());
        _xy[_i][0] = Double.parseDouble(_c[2].trim());
        _xy[_i][1] = Double.parseDouble(_c[3].trim());
        for (int _t = 0; _t < 6; _t++) muA[_i][_t] = Double.parseDouble(_c[4 + _t].trim());
        _S[_i][0] = Double.parseDouble(_c[10].trim());
        _g[_i]  = Integer.parseInt(_c[11].trim());
        _rA[_i] = Integer.parseInt(_c[12].trim());
        for (int _t = 0; _t < 6; _t++) _pdq[_i][_t] = (int) Math.round(Double.parseDouble(_c[13 + _t].trim()));
        // SEGMENT EXTENSION (backward compatible): cols 19-24 mu dry, 25-30 mu frozen, 31 S dry, 32 S frozen
        if (_c.length >= 33) {
            for (int _t = 0; _t < 6; _t++) muB[_i][_t] = Double.parseDouble(_c[19 + _t].trim());
            for (int _t = 0; _t < 6; _t++) muC[_i][_t] = Double.parseDouble(_c[25 + _t].trim());
            _S[_i][1] = Double.parseDouble(_c[31].trim());
            _S[_i][2] = Double.parseDouble(_c[32].trim());
        }
    }
} catch (Exception _e) { traceln("ERROR reading stores csv: " + _e); }

// 1) store positions (raw km * 10 == pixels, because KM_PER_PX = 0.1)
for (int _i = 0; _i < _N; _i++) stores.get(_i).setXY(_xy[_i][0] * 10.0, _xy[_i][1] * 10.0);

// 2) demand rates (setLambda); Sunday = 0
String[] dppDays = {"Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"};
for (int s = 0; s < _N; s++) {
    for (int d = 0; d < 6; d++) {
        setLambda(dppDays[d], s, "A", muA[s][d]);   // fresh
        setLambda(dppDays[d], s, "B", muB[s][d]);   // dry    (0 if CSV has no segment cols)
        setLambda(dppDays[d], s, "C", muC[s][d]);   // frozen (0 if CSV has no segment cols)
    }
    setLambda("Sunday", s, "A", 0.0);
    setLambda("Sunday", s, "B", 0.0);
    setLambda("Sunday", s, "C", 0.0);
}

// 3) weekly routes from routes csv
java.util.TreeMap<Integer, java.util.TreeMap<Integer, java.util.TreeMap<Integer,Integer>>> _rt = new java.util.TreeMap<>();
try (java.io.BufferedReader _br = new java.io.BufferedReader(new java.io.FileReader(_dir + "routes_" + _name + ".csv"))) {
    _br.readLine();
    String _ln;
    while ((_ln = _br.readLine()) != null) {
        if (_ln.trim().isEmpty()) continue;
        String[] _c = _ln.split(",");
        int _day = Integer.parseInt(_c[0].trim());
        int _rid = Integer.parseInt(_c[1].trim());
        int _seq = Integer.parseInt(_c[2].trim());
        int _si  = Integer.parseInt(_c[3].trim());
        _rt.computeIfAbsent(_day, k -> new java.util.TreeMap<>()).computeIfAbsent(_rid, k -> new java.util.TreeMap<>()).put(_seq, _si);
    }
} catch (Exception _e) { traceln("ERROR reading routes csv: " + _e); }
weeklyRoutes.clear();
for (int _day : _rt.keySet()) {
    for (int _rid : _rt.get(_day).keySet()) {
        java.util.List<Store> _seq = new java.util.ArrayList<Store>();
        for (int _si : _rt.get(_day).get(_rid).values()) _seq.add(stores.get(_si));
        weeklyRoutes.add(new Route(dppDays[_day], 6.0, warehouses.get(0), _seq));
    }
}

// 4) plannedDeliveryQty (scheduled-day flag) + targetLevelS (order-up-to S)
plannedDeliveryQty = new int[stores.size()][6];
for (int _i = 0; _i < _N; _i++) plannedDeliveryQty[_i] = _pdq[_i];
targetLevelS = new double[stores.size()][3];
for (int _i = 0; _i < _N; _i++) targetLevelS[_i] = _S[_i];
// per-instance CapA(=gamma) + R_A(=ceil(S)); arrays pre-allocated by the excelCapFile resource (skip if absent)
if (maxCapByStoreProduct != null) {
    for (int _i = 0; _i < _N; _i++) {
        maxCapByStoreProduct[_i][0] = _g[_i];
        maxCapByStoreTotal[_i]      = _g[_i];
        rpByStoreProduct[_i][0]     = _rA[_i];
    }
}
traceln("DATA-DRIVEN: loaded " + _name + " (" + _N + " stores, " + weeklyRoutes.size() + " routes)");
traceln("plannedDeliveryQty loaded (" + stores.size() + " stores).");
pendingOrderQty = new int[stores.size()][3];
deliverTodayQty = new int[stores.size()][3];
ProductUnit.skippedTodayByStore = new boolean[stores.size()];
preStocked = new boolean[stores.size()];
pFIFO = 0.70; shelfLifeDays = 4; demandCV = 0.25;   // shelfLifeDays applies to product A (fresh) only; B/C never expire
simDay = -1;
for (int _i = 0; _i < targetLevelS.length; _i++)
    for (int _p = 0; _p < 3; _p++) pendingOrderQty[_i][_p] = (int) Math.round(targetLevelS[_i][_p]);
]]></StartupCode>
