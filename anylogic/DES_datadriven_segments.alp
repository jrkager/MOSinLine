				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1755446905028</Id>
					<Name><![CDATA[refillPlannedDemandsForToday]]></Name>
					<X>1720</X><Y>600</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[plannedDemands.clear();

int dayIdx = getCurrentDayIndex();

for (int store = 0; store < stores.size(); store++) {
    String[] prods = { "A", "B", "C" };
    for (String prod : prods) {
        double lambdaVal = getLambda(dayIdx, store, prod);
        if (lambdaVal <= 0) continue;

        int n = Math.max(0, (int) Math.round(normal(demandCV * lambdaVal, lambdaVal)));

        for (int k = 0; k < n; k++) {
            plannedDemands.add(new DemandSpec(store, prod));
        }
    }
}

java.util.Collections.shuffle(plannedDemands);
traceln("Today's total demand: " + plannedDemands.size());

]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1755448004310</Id>
					<Name><![CDATA[rebuildPlannedSummary]]></Name>
					<X>1720</X><Y>520</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// store × product bazında plannedDemands listesini say
java.util.Map<String, Integer> agg = new java.util.HashMap<>();
for (DemandSpec d : plannedDemands) {
    String key = d.storeID + "_" + d.productType;
    agg.put(key, agg.getOrDefault(key, 0) + 1);
}

// plan özetini güncelle
plannedSummary.clear();
for (java.util.Map.Entry<String,Integer> e : agg.entrySet()) {
    String key = e.getKey();
    int us = key.indexOf('_');
    int store = Integer.parseInt(key.substring(0, us));
    String prod = key.substring(us + 1);
    plannedSummary.add(new PlannedRow(store, prod, e.getValue()));
}

// okunabilirlik için sırala
plannedSummary.sort((a,b) -> {
    if (a.storeID != b.storeID) return Integer.compare(a.storeID, b.storeID);
    return a.productType.compareTo(b.productType);
});
]]></Body>
				</Function>
