					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[int dayIdx = getCurrentDayIndex(); // 1..7
String[] dayNames = { "Sunday","Monday","Tuesday","Wednesday","Thursday","Friday","Saturday" };
String today = dayNames[dayIdx - 1];

for (Route r : weeklyRoutes) {
    if (r.day.equals(today)) {
        r.dispatched = false;
    }
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1755467904523</Id>
					<Name><![CDATA[reportUrgencyDebug]]></Name>
					<X>1720</X><Y>660</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[int currentDayIdx = getCurrentDayIndex(); // 1..7
String[] dayNames = { "Sunday","Monday","Tuesday","Wednesday","Thursday","Friday","Saturday" };
String currentDayName = dayNames[currentDayIdx - 1];

if (!urgencyDebugHeaderWritten) {
    writeToCSV("Time;Day;StoreID;Product;OnHand;OnOrder;MuUntilNext;Safety;Urgency", "UrgencyDebug.csv");
    urgencyDebugHeaderWritten = true;
}

for (Store s : stores) {
    for (String product : java.util.List.of("A","B","C")) {
        int onHand = ("A".equals(product)) ? s.stockA.size()
                   : ("B".equals(product)) ? s.stockB.size()
                   : s.stockC.size();

        int onOrder = 0;
        for (Order o : s.assignedWarehouse.orderQueue) {
            if (o.store == s && o.productType.equals(product)) onOrder += o.quantity;
        }

        double mu = expectedDemandUntilNext(s, product, currentDayIdx);
        double safety = urgencyZ * Math.sqrt(Math.max(mu, 0.0));

        // Sadece bir kez tanımla
        double urgency = (onHand + onOrder) - (mu + safety);

        String line = String.format(
            "%.2f;%s;%d;%s;%d;%d;%.4f;%.4f;%.4f",
            time(), currentDayName, s.storeID, product,
            onHand, onOrder, mu, safety, urgency
        );
        writeToCSV(line, "UrgencyDebug.csv");
    }
}
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1755468524967</Id>
					<Name><![CDATA[daysUntilNextDelivery]]></Name>
					<X>1720</X><Y>540</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[s]]></Name>
						<Type><![CDATA[Store]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[currentDay]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[int nextIdx = getNextDeliveryDayIndex(s); // 1..7, yoksa 8
if (nextIdx == 8) return 7;               // plan yoksa 1 hafta varsay
return (nextIdx - currentDay + 7) % 7;    // 0..6]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1758983524181</Id>
					<Name><![CDATA[recalcKPIs]]></Name>
					<X>1720</X><Y>680</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[int n = (truckStatsTable == null) ? 0 : truckStatsTable.size();

if (n == 0) {
    kpiAvgDistanceKm = 0;
    kpiAvgFillPct    = 0;
    kpiTotalCO2Kg    = 0;
    kpiTotalFuelCost = 0;
    return;
}

double sumDistKm   = 0;
double sumFill     = 0;
double sumCO2      = 0;
double sumFuelCost = 0;

for (TruckStats ts : truckStatsTable) {
    sumDistKm   += ts.totalDistance;
    sumFill     += ts.fillRate;
    sumCO2      += ts.co2Emissions;
    sumFuelCost += ts.fuelCost;
}

kpiAvgDistanceKm = sumDistKm / n;

double avgFillRaw = sumFill / n;
kpiAvgFillPct = (avgFillRaw <= 1.0) ? (avgFillRaw * 100.0) : avgFillRaw;

kpiTotalCO2Kg = sumCO2/1000;

kpiTotalFuelCost = sumFuelCost;

double totalStockoutCost = 0.0;
for (Store s : stores) {
    totalStockoutCost
        += s.lostDemandA * stockoutCostA
         + s.lostDemandB * stockoutCostB
         + s.lostDemandC * stockoutCostC;
}
kpiTotalStockoutCost = totalStockoutCost;
]]></Body>
				</Function>
			</Functions>
