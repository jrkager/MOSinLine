		<!--   =========   Java Class   ========  -->
		<JavaClass>
			<Id>1741815685504</Id>
			<Name><![CDATA[Order]]></Name>
			<Text><![CDATA[import java.io.Serializable;

public class Order implements Serializable {

    public Store store;
    public String productType;
    public int quantity;
    public Warehouse warehouse;  // Yeni eklenen alan

    /**
     * Default constructor
     */
    public Order() {
    }

    /**
     * Constructor initializing the fields
     */
    public Order(Store store, String productType, int quantity, Warehouse warehouse) {
        this.store = store;
        this.productType = productType;
        this.quantity = quantity;
        this.warehouse = warehouse;
    }

    @Override
    public String toString() {
        return  
            "store = " + store + " " +
            "productType = " + productType + " " +
            "quantity = " + quantity + " " +
            "warehouse = " + warehouse;
    }

    /**
     * This number is here for model snapshot storing purpose<br>
     * It needs to be changed when this class gets changed
     */ 
    private static final long serialVersionUID = 2L; // versiyon numarasını değiştirdim
}]]></Text>
		</JavaClass>
		<!--   =========   Java Class   ========  -->
		<JavaClass>
			<Id>1743256416743</Id>
			<Name><![CDATA[Route]]></Name>
			<Text><![CDATA[import java.io.Serializable;
import java.util.ArrayList;
import java.util.List;

/**
 * Route
 */	
public class Route implements Serializable {

	public String day;
	public double hour;
	public Warehouse warehouse;
	public List<Store> deliveryList = new ArrayList<>();

	public boolean dispatched = false; // ✅ Yeni eklenen flag

	/**
	 * Default constructor
	 */
	public Route() {
	}

	/**
	 * Constructor initializing the fields
	 */
	public Route(String day, double hour, Warehouse warehouse, List<Store> deliveryList) {
		this.day = day;
		this.hour = hour;
		this.warehouse = warehouse;
		this.deliveryList = deliveryList;
	}

	@Override
	public String toString() {
		return  
			"day = " + day + " " +
			"hour = " + hour + " " +
			"warehouse = " + warehouse + " " +
			"deliveryList = " + deliveryList + " ";
	}

	/**
	 * This number is here for model snapshot storing purpose<br>
	 * It needs to be changed when this class gets changed
	 */ 
	private static final long serialVersionUID = 1L;

}
]]></Text>
		</JavaClass>
		<!--   =========   Java Class   ========  -->
		<JavaClass>
			<Id>1748095730399</Id>
			<Name><![CDATA[TruckStats]]></Name>
			<Text><![CDATA[import java.io.Serializable;

public class TruckStats implements Serializable {

	private static final long serialVersionUID = 1L;

	public int truckID;
	public String dispatchDate;
	public double totalDistance;
	public int totalUnits;
	public double totalWeight;
	public double fuelCost;
	public double co2Emissions;
	public double totalTravelTime;
	public String storeList;
	public double fillRate; // ➕ yeni alan (% olarak doluluk oranı)

	// Güncellenmiş constructor
	public TruckStats(int truckID, String dispatchDate, double totalDistance, int totalUnits,
					  double totalWeight, double fuelCost, double co2Emissions, double totalTravelTime,
					  String storeList, double fillRate) {
		this.truckID = truckID;
		this.dispatchDate = dispatchDate;
		this.totalDistance = totalDistance;
		this.totalUnits = totalUnits;
		this.totalWeight = totalWeight;
		this.fuelCost = fuelCost;
		this.co2Emissions = co2Emissions;
		this.totalTravelTime = totalTravelTime;
		this.storeList = storeList;
		this.fillRate = fillRate;
	}

	@Override
	public String toString() {
		return "Truck " + truckID +
			   " | Distance: " + totalDistance +
			   " | Units: " + totalUnits +
			   " | FillRate: " + String.format("%.1f%%", fillRate);
	}
}
]]></Text>
		</JavaClass>
		<!--   =========   Java Class   ========  -->
		<JavaClass>
			<Id>1749820698578</Id>
			<Name><![CDATA[ProductUnit]]></Name>
			<Text><![CDATA[/**
 * ProductUnit - Store içinde bireysel ürün takibi için
 */
public class ProductUnit implements Serializable {

    public String type;          // Ürün tipi: A, B, C
    public double receivedTime; // Ürünün mağazada teslim alındığı an (time())
    public int expiryDay;       // ALNS day-based expiry: working-day index at which this unit expires

    // Variant-4/8 support: stores whose delivery was skipped TODAY by the drop-<5
    // or cancel-<15 rules (reset each morning). Static registry here to avoid
    // touching the AnyLogic variable structure.
    public static boolean[] skippedTodayByStore;
    // Rule flags for the 8-variant scheme (set in Main startup; V5=drop only, V6=cancel only, ...)
    public static boolean dropActive = false;
    public static boolean cancelActive = false;

    public ProductUnit(String type, double receivedTime) {
        this.type = type;
        this.receivedTime = receivedTime;
    }

    @Override
    public String toString() {
        return type + " (received at " + receivedTime + ")";
    }

    private static final long serialVersionUID = 1L;
}
]]></Text>
		</JavaClass>
		<!--   =========   Java Class   ========  -->
		<JavaClass>
			<Id>1755446841499</Id>
			<Name><![CDATA[DemandSpec]]></Name>
			<Text><![CDATA[import java.io.Serializable;

public class DemandSpec implements Serializable {
    public final int storeID;
    public final String productType;

    public DemandSpec(int storeID, String productType) {
        this.storeID = storeID;
        this.productType = productType;
    }

    private static final long serialVersionUID = 1L;
}
]]></Text>
		</JavaClass>
		<!--   =========   Java Class   ========  -->
		<JavaClass>
			<Id>1755447942149</Id>
			<Name><![CDATA[PlannedRow]]></Name>
			<Text><![CDATA[import java.io.Serializable;

public class PlannedRow implements Serializable {
    public final int storeID;
    public final String productType;
    public final int count;

    public PlannedRow(int storeID, String productType, int count) {
        this.storeID = storeID;
        this.productType = productType;
        this.count = count;
    }

    private static final long serialVersionUID = 1L;
}
]]></Text>
		</JavaClass>
