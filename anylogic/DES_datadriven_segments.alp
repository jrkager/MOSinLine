					<Body><![CDATA[if (!routeCancelHeaderWritten) {
    writeToCSV("Time;Warehouse;Day;OriginalUnits;Threshold;Reason", "RouteCancellations.csv");
    routeCancelHeaderWritten = true;
}
String reason = "Original load below threshold";
