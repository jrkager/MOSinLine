						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[double now = time();
List<ProductUnit> delivered = new ArrayList<>();

for (int i = 0; i < quantity; i++) {
    ProductUnit pu = new ProductUnit(productType, now);
            // A (fresh): 4 working-day shelf life; B (dry) / C (frozen): no expiry within the horizon
            pu.expiryDay = "A".equals(productType)
                ? get_Main().simDay + get_Main().shelfLifeDays
                : get_Main().simDay + 999999;
            delivered.add(pu);
}

if (productType.equals("A")) {
    stockA.addAll(delivered);
} else if (productType.equals("B")) {
    stockB.addAll(delivered);
} else if (productType.equals("C")) {
    stockC.addAll(delivered);
}
]]></Body>
				</Function>
			</Functions>
