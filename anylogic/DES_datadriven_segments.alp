					<Parameter>
						<Name><![CDATA[store]]></Name>
						<Type><![CDATA[Store]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[productType]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[quantity]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[//traceln("📦 Warehouse " + this + " received request from Store "
//        + store.storeID + " for " + quantity + " of " + productType);

Order newOrder = new Order(store, productType, quantity, this); // ✅ doğru
orderQueue.add(newOrder);

//traceln("📥 Order added to queue: Store " + store.storeID
//        + ", Product: " + productType + ", Quantity: " + quantity);
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1743257661021</Id>
					<Name><![CDATA[dispatchTruck]]></Name>
					<X>150</X><Y>140</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[deliveryList]]></Name>
						<Type><![CDATA[List<Store>]]></Type>
					</Parameter>
					<Body><![CDATA[// === Execute the DPPP route (one route = one truck, multi-stop) with execution variants ===
// Variant 2: plan as-is (no drop / no cancel / no piggyback).
// Variants 1/3/4 add: DROP a store's delivery if its total planned drop < DROP_THRESHOLD units;
// CANCEL the route if its total planned load < minOriginalRouteUnits (=15);
// PIGGYBACK (V1: all eligible stores / V4: only skipped stores) when fill rate < 75%.

double MAX_CAPACITY = get_Main().truckCapacity;
int DROP_THRESHOLD = 5;  // Variants 1/3/4: minimum viable store drop (total over products); gated by enableDynamicDispatch

// 0) CANCEL rule (Variants 1/3/4): cancel the route if its total planned load < minOriginalRouteUnits (=15)
int originalUnits = 0;
for (Store store : deliveryList) {
    for (int _p = 0; _p < 3; _p++) originalUnits += get_Main().deliverTodayQty[store.storeID][_p];
}
if (ProductUnit.cancelActive && originalUnits < get_Main().minOriginalRouteUnits) {
    String[] dayNames = { "Sunday","Monday","Tuesday","Wednesday","Thursday","Friday","Saturday" };
    int idx = get_Main().getCurrentDayIndex();
    String dayName = dayNames[ ((idx - 1) % 7 + 7) % 7 ];
    get_Main().logRouteCancellation(this, dayName, originalUnits, get_Main().minOriginalRouteUnits);
    traceln("Route cancelled: original load " + originalUnits +
            " < threshold " + get_Main().minOriginalRouteUnits);
    for (Store store : deliveryList) {   // Variant-4 registry + PHYSICAL skip: remove the 05:00 morning stock again
        int _t = 0; for (int _p = 0; _p < 3; _p++) _t += get_Main().deliverTodayQty[store.storeID][_p];
        if (_t > 0 && ProductUnit.skippedTodayByStore != null) ProductUnit.skippedTodayByStore[store.storeID] = true;
        // un-deliver: today's units sit at the END of each shelf list (added at 05:00, demand starts 08:00)
        for (int _p = 0; _p < 3; _p++) {
            int _rm = get_Main().deliverTodayQty[store.storeID][_p];
            java.util.List<ProductUnit> _sl = (_p == 0) ? store.stockA : (_p == 1) ? store.stockB : store.stockC;
            while (_rm > 0 && !_sl.isEmpty()) { _sl.remove(_sl.size() - 1); _rm--; }
        }
    }
    return;
}

// 1) Build this route's orders from the FIXED ALNS delivery quantities
//    (plannedDeliveryQty[storeIndex][dayIndex 0=Mon..5=Sat]), in deliveryList (stop) order.
//    Decoupled from orderQueue => no 6am-vs-demand timing strand, no accumulation,
//    truck load == ALNS route load (<= Q by construction).
int dppDay = get_Main().getCurrentDayIndex() - 2;   // Mon(2)->0 .. Sat(7)->5 ; Sunday(1)->-1
List<Order> relevantOrders = new ArrayList<>();
if (dppDay >= 0 && dppDay <= 5) {
    for (Store store : deliveryList) {
        // LEAD-1: deliver the orders committed yesterday, PER PRODUCT (co-delivery on one truck)
        int qtyA = get_Main().deliverTodayQty[store.storeID][0];
        int qtyB = get_Main().deliverTodayQty[store.storeID][1];
        int qtyC = get_Main().deliverTodayQty[store.storeID][2];
        if (qtyA > 0) relevantOrders.add(new Order(store, "A", qtyA, this));
        if (qtyB > 0) relevantOrders.add(new Order(store, "B", qtyB, this));
        if (qtyC > 0) relevantOrders.add(new Order(store, "C", qtyC, this));
    }
}

// DROP rule (Variants 1/3/4): skip any store whose TOTAL planned drop today (all products,
// co-delivery bundle) is < DROP_THRESHOLD units. The whole bundle is dropped -- the rule's
// point is that visiting a store for a tiny drop is not worth the stop.
if (ProductUnit.dropActive && DROP_THRESHOLD > 0) {
    java.util.Map<Store, Integer> _tot = new java.util.LinkedHashMap<>();
    for (Order o : relevantOrders) _tot.merge(o.store, o.quantity, Integer::sum);
    java.util.List<Order> _kept = new java.util.ArrayList<>();
    for (Order o : relevantOrders) {
        if (_tot.get(o.store) < DROP_THRESHOLD) {
            if (ProductUnit.skippedTodayByStore != null) ProductUnit.skippedTodayByStore[o.store.storeID] = true;   // Variant-4 registry
        } else {
            _kept.add(o);
        }
    }
    // PHYSICAL skip: remove the 05:00 morning stock of dropped stores again (per product,
    // today's units are at the END of each shelf list; demand window has not started yet)
    java.util.Set<Store> _droppedStores = new java.util.HashSet<>();
    for (Store _ds : _tot.keySet()) if (_tot.get(_ds) < DROP_THRESHOLD) _droppedStores.add(_ds);
    for (Store _ds : _droppedStores) {
        for (int _p = 0; _p < 3; _p++) {
            int _rm = get_Main().deliverTodayQty[_ds.storeID][_p];
            java.util.List<ProductUnit> _sl = (_p == 0) ? _ds.stockA : (_p == 1) ? _ds.stockB : _ds.stockC;
            while (_rm > 0 && !_sl.isEmpty()) { _sl.remove(_sl.size() - 1); _rm--; }
        }
    }
    for (Store _ds : _tot.keySet()) {
        if (_tot.get(_ds) < DROP_THRESHOLD)
            traceln("DROP rule: Store " + _ds.storeID + " total drop " + _tot.get(_ds) + " < " + DROP_THRESHOLD + " -> skipped today");
    }
    relevantOrders = _kept;
}

if (relevantOrders.isEmpty()) {
    traceln("No orders for this route today; nothing to dispatch.");
    return;
}

// 2) Merge same store + productType lines (keeps quantities, no splitting)
Map<String, Order> combinedOrdersMap = new LinkedHashMap<>();
for (Order o : relevantOrders) {
    String key = o.store.storeID + "_" + o.productType;
    if (combinedOrdersMap.containsKey(key)) {
        combinedOrdersMap.get(key).quantity += o.quantity;
    } else {
        combinedOrdersMap.put(key, new Order(o.store, o.productType, o.quantity, this));
    }
}
List<Order> orderBatch = new ArrayList<>(combinedOrdersMap.values());

// 3) Build the stop list in deliveryList order (only stores that actually ordered)
Set<Store> batchStores = new HashSet<>();
for (Order o : orderBatch) batchStores.add(o.store);
List<Store> pendingStoresOrdered = new ArrayList<>();
for (Store s : deliveryList) {
    if (batchStores.contains(s) && !pendingStoresOrdered.contains(s)) {
        pendingStoresOrdered.add(s);
    }
}

// 4) Reporting strings (all planned; no supplements in this evaluation mode)
String plannedStr = pendingStoresOrdered.stream()
    .map(s -> "Store " + s.storeID)
    .collect(java.util.stream.Collectors.joining(", "));
String supplementStr = "";

// === PIGGYBACK (Variants 1 & 4): triggered when route fill rate < 75% ===
// Variant 1 (piggybackVersion==1): candidates = ANY store not scheduled today.
// Variant 4 (piggybackVersion==4): candidates = ONLY stores whose delivery was skipped
//                                  today by the drop/cancel rules.
// Both variants use the SAME ranking (urgency score, most critical product first) so that
// V1-vs-V4 isolates the candidate-set effect, and the same nearest-detour constraint
// (MAX_SUPPLEMENT_DISTANCE from the last planned stop). Quantities: per-product top-up
// toward S (A, then B, then C), capped by remaining truck capacity (partial allowed).
// preStocked[] = same-day dedup only; no scheduled future delivery is ever skipped.
if (get_Main().piggybackVersion > 0 && !pendingStoresOrdered.isEmpty()) {
    double _load = orderBatch.stream().mapToInt(o -> o.quantity).sum();
    if (_load < 0.75 * MAX_CAPACITY) {                       // fill-rate trigger (< 75%)
        double _spare = MAX_CAPACITY - _load;
        Store _last = pendingStoresOrdered.get(pendingStoresOrdered.size() - 1);
        int _dayIdx = get_Main().getCurrentDayIndex();
        List<Store> _cand = new ArrayList<>();
        Map<Store, Double> _key = new HashMap<>();
        for (Store _s : get_Main().stores) {
            int _sid = _s.storeID;
            if (pendingStoresOrdered.contains(_s)) continue;                                    // already on this route
            if (get_Main().preStocked[_sid]) continue;                                          // already piggybacked today
            if (get_Main().piggybackVersion == 4) {
                if (ProductUnit.skippedTodayByStore == null
                    || !ProductUnit.skippedTodayByStore[_sid]) continue;                        // V4: skipped stores only
            } else {
                if (dppDay >= 0 && get_Main().plannedDeliveryQty[_sid][dppDay] > 0) continue;   // V1: scheduled today -> own route serves it
            }
            int _tA = Math.max(0, (int) Math.round(get_Main().targetLevelS[_sid][0] - _s.stockA.size()));
            int _tB = Math.max(0, (int) Math.round(get_Main().targetLevelS[_sid][1] - _s.stockB.size()));
            int _tC = Math.max(0, (int) Math.round(get_Main().targetLevelS[_sid][2] - _s.stockC.size()));
            if (_tA + _tB + _tC <= 0) continue;                                                 // already at/above order-up-to level S
            double _d = Math.hypot(_s.getX() - _last.getX(), _s.getY() - _last.getY());
            if (_d > get_Main().MAX_SUPPLEMENT_DISTANCE) continue;                               // too far to detour
            double _u = Math.min(get_Main().calculateUrgencyScore(_s, "A", _dayIdx),
                        Math.min(get_Main().calculateUrgencyScore(_s, "B", _dayIdx),
                                 get_Main().calculateUrgencyScore(_s, "C", _dayIdx)));
            _cand.add(_s);
            _key.put(_s, _u);                                                                   // lower (more negative) = more urgent
        }
        _cand.sort(java.util.Comparator.comparingDouble(_key::get));
        List<Store> _added = new ArrayList<>();
        for (Store _s : _cand) {
            int _sid = _s.storeID;
            int[] _t = new int[3];
            _t[0] = Math.max(0, (int) Math.round(get_Main().targetLevelS[_sid][0] - _s.stockA.size()));
            _t[1] = Math.max(0, (int) Math.round(get_Main().targetLevelS[_sid][1] - _s.stockB.size()));
            _t[2] = Math.max(0, (int) Math.round(get_Main().targetLevelS[_sid][2] - _s.stockC.size()));
            String[] _pn = { "A", "B", "C" };
            boolean _any = false;
            for (int _p = 0; _p < 3 && _spare > 0; _p++) {
                int _q = Math.min((int) _spare, _t[_p]);
                if (_q <= 0) continue;
                orderBatch.add(new Order(_s, _pn[_p], _q, this));
                _s.receiveDelivery(_pn[_p], _q);
                _spare -= _q;
                _any = true;
            }
            if (_any) {
                pendingStoresOrdered.add(_s);
                get_Main().preStocked[_sid] = true;                                             // same-day dedup only
                _added.add(_s);
            }
            if (_spare <= 0) break;
        }
        if (!_added.isEmpty()) {
            supplementStr = _added.stream().map(x -> "Store " + x.storeID).collect(java.util.stream.Collectors.joining(", "));
        }
    }
}

// 5) Assign and enqueue exactly one truck for the whole route
pendingOrders = orderBatch;
pendingStores = pendingStoresOrdered;

int totalUnits = orderBatch.stream().mapToInt(o -> o.quantity).sum();
get_Main().rsRouteCountTotal++;
if (totalUnits > MAX_CAPACITY) get_Main().rsOverloadCount++;
traceln("Dispatching ROUTE as-is: " + pendingStoresOrdered.size() +
        " stops, " + orderBatch.size() + " orders, total load: " + totalUnits +
        (totalUnits > MAX_CAPACITY ? "  [WARNING: load " + totalUnits +
         " > truckCapacity " + (int)MAX_CAPACITY + "]" : ""));
traceln("Route (planned): " + pendingStoresOrdered.stream()
        .map(s -> "Store " + s.storeID).toList());

get_Main().truckOrderQueue.add(new ArrayList<>(orderBatch));
get_Main().truckStoreQueue.add(new ArrayList<>(pendingStoresOrdered));
get_Main().truckPlannedStoreStrQueue.add(plannedStr);
get_Main().truckSupplementStoreStrQueue.add(supplementStr);

// 6) Dispatch one truck for this route
truckSource.inject(1);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1755467307681</Id>
					<Name><![CDATA[consumeTakenOrders]]></Name>
					<X>340</X><Y>120</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[takenOrders]]></Name>
						<Type><![CDATA[List<Order>]]></Type>
					</Parameter>
					<Body><![CDATA[for (Order taken : takenOrders) {
    // Ek sipariş hangi depodan geldiyse o deponun kuyruğundan düş
    Warehouse srcW = taken.warehouse;
    if (srcW == null) continue;

    int remaining = taken.quantity;
    java.util.Iterator<Order> it = srcW.orderQueue.iterator();
    while (it.hasNext() && remaining > 0) {
        Order qo = it.next();
        if (qo.store == taken.store && qo.productType.equals(taken.productType)) {
            int dec = Math.min(qo.quantity, remaining);
            qo.quantity -= dec;
            remaining -= dec;
            if (qo.quantity <= 0) {
                it.remove();
            }
        }
    }
    if (remaining > 0) {
        traceln("Warning: could not fully consume taken order for Store "
                + taken.store.storeID + " " + taken.productType
                + ". Remaining=" + remaining);
    }
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1755467587384</Id>
					<Name><![CDATA[dispatchRoute]]></Name>
					<X>340</X><Y>140</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[route]]></Name>
						<Type><![CDATA[Route]]></Type>
					</Parameter>
					<Body><![CDATA[if (route == null) return;
if (route.dispatched) return;   

try {
    dispatchTruck(route.deliveryList);
} finally {
    route.dispatched = true;
}]]></Body>
				</Function>
