				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1748511917963</Id>
					<Name><![CDATA[calculateUrgencyScore]]></Name>
					<X>1090</X><Y>90</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[store]]></Name>
						<Type><![CDATA[Store]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[productType]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[currentDay]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[// store, productType, currentDay (1..7) argümanlı

// 1) Elde stok (on-hand)
int onHand = 0;
if ("A".equals(productType))      onHand = store.stockA.size();
else if ("B".equals(productType)) onHand = store.stockB.size();
else                               onHand = store.stockC.size();

// 2) Yolda olan miktar (on-order) — yalnızca mağazanın assignedWarehouse kuyruğundan
int onOrder = 0;
for (Order o : store.assignedWarehouse.orderQueue) {
    if (o.store == store && o.productType.equals(productType)) {
        onOrder += o.quantity;
    }
}

// 3) Teslimata kadar beklenen talep (μ) ve güvenlik stoğu
double mu = expectedDemandUntilNext(store, productType, currentDay);   // Adım 3'te ekledin
double safety = urgencyZ * Math.sqrt(Math.max(mu, 0.0));    // Adım 1'de ekledin

// 4) Aciliyet skoru (negatif daha acil)
double urgency = (onHand + onOrder) - (mu + safety);
return urgency;
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1748512466425</Id>
					<Name><![CDATA[getCurrentDayIndex]]></Name>
					<X>1720</X><Y>560</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// FIX: model starts 2025-03-03 (Monday). Day-of-week from elapsed model days (timezone-independent).
// Old code used new Date(time()*3600*1000) = ms since 1970-01-01 (a Thursday) -> +3-day calendar shift.
int _dayCount = (int) Math.floor(time() / 24.0);
return ((1 + _dayCount) % 7) + 1; // Sunday=1 .. Saturday=7 ; model_day 0 -> Monday(2)
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1748512479941</Id>
					<Name><![CDATA[getDayIndexFromName]]></Name>
					<X>1720</X><Y>580</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[dayName]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[switch(dayName) {
    case "Sunday": return 1;
    case "Monday": return 2;
    case "Tuesday": return 3;
    case "Wednesday": return 4;
    case "Thursday": return 5;
    case "Friday": return 6;
    case "Saturday": return 7;
}
return 8; // bilinmeyen gün ismi
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1748512495954</Id>
					<Name><![CDATA[getNextDeliveryDayIndex]]></Name>
					<X>1090</X><Y>110</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[s]]></Name>
						<Type><![CDATA[Store]]></Type>
					</Parameter>
					<Body><![CDATA[Warehouse w = s.assignedWarehouse;
if (w == null) return 8; // fallback

int today = getCurrentDayIndex(); // 1..7

// 1) Bugünden itibaren aynı depolu en yakın günü ara
for (Route r : weeklyRoutes) {
    if (r.warehouse == w && r.deliveryList.contains(s)) {
        int idx = getDayIndexFromName(r.day); // 1..7
        if (idx >= today) {
            return idx;
        }
    }
}

// 2) Bu hafta içinde daha önceki günlerde varsa (haftaya devre)
int best = 8; // fallback
for (Route r : weeklyRoutes) {
    if (r.warehouse == w && r.deliveryList.contains(s)) {
        int idx = getDayIndexFromName(r.day);
        // En yakın geçmiş günü seç (ör. bugün Cuma ise Perşembe → haftaya +6 gün)
        if (best == 8 || idx < best) best = idx;
    }
}
return best; // hiç yoksa 8]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1749822392430</Id>
					<Name><![CDATA[reportWeeklyWaste]]></Name>
					<X>1720</X><Y>480</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double currentTime = time();
int weekNumber = (int)(currentTime / (24 * 7));

traceln("[RS] cumulative overloaded routes: " + rsOverloadCount + " / " + rsRouteCountTotal);

if (!headerWritten) {
    writeToCSV("WeekNumber;Time;StoreID;WasteCount;WasteA_fresh;WasteB_dry;WasteC_frozen;CO2Emissions_kg", "WeeklyWasteReport.csv");
    headerWritten = true;
}

for (Store s : stores) {
    int deltaWasteCount = s.wasteCount - s.prevWasteCount;
    int deltaWasteA = s.wasteCountA - s.prevWasteCountA;
    int deltaWasteB = s.wasteCountB - s.prevWasteCountB;
    int deltaWasteC = s.wasteCountC - s.prevWasteCountC;

    double co2Emissions = (deltaWasteA * co2PerUnitA) +
                          (deltaWasteB * co2PerUnitB) +
                          (deltaWasteC * co2PerUnitC);

    String line = weekNumber + ";" +
                  currentTime + ";" +
                  s.storeID + ";" +
                  deltaWasteCount + ";" +
                  deltaWasteA + ";" +
                  deltaWasteB + ";" +
                  deltaWasteC + ";" +
                  co2Emissions;

    writeToCSV(line, "WeeklyWasteReport.csv");

    s.prevWasteCount = s.wasteCount;
    s.prevWasteCountA = s.wasteCountA;
    s.prevWasteCountB = s.wasteCountB;
    s.prevWasteCountC = s.wasteCountC;
}
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[List<Order>]]></ReturnType>
					<Id>1753459607909</Id>
					<Name><![CDATA[findSupplementOrders]]></Name>
					<X>1090</X><Y>130</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[neededQuantity]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[warehouse]]></Name>
						<Type><![CDATA[Warehouse]]></Type>
					</Parameter>
					<Body><![CDATA[// neededQuantity:int, warehouse:Warehouse

// 1) Aday mağazalar: herhangi bir depoda (tüm warehouses) bu mağaza için bekleyen sipariş olmalı
Map<Store, Double> storeUrgency = new HashMap<>();
List<Store> candidates = new ArrayList<>();

int currentDay = getCurrentDayIndex();

for (Store s : stores) {
    boolean hasAnyOrder = false;
    // Bu mağaza için bekleyen ürün tiplerini topla
    boolean hasA = false, hasB = false, hasC = false;
    for (Warehouse w : warehouses) {
        for (Order o : w.orderQueue) {
            if (o.store == s) {
                hasAnyOrder = true;
                if ("A".equals(o.productType)) hasA = true;
                else if ("B".equals(o.productType)) hasB = true;
                else if ("C".equals(o.productType)) hasC = true;
            }
        }
    }
    if (!hasAnyOrder) continue; // sipariş yoksa bu mağaza tamamlayıcı için anlamlı değil

    // Mağaza skoru = siparişi olan ürünler arasında en kötü (en negatif) aciliyet
    double best = Double.POSITIVE_INFINITY;
    if (hasA) best = Math.min(best, calculateUrgencyScore(s, "A", currentDay));
    if (hasB) best = Math.min(best, calculateUrgencyScore(s, "B", currentDay));
    if (hasC) best = Math.min(best, calculateUrgencyScore(s, "C", currentDay));

    storeUrgency.put(s, best);
    candidates.add(s);
}


// 2) Artan sırala (daha negatif → daha acil → önce)
candidates.sort(Comparator.comparingDouble(storeUrgency::get));

// 3) Mesafe kısıtı: son planlanan mağazaya uzaklık ≤ MAX_SUPPLEMENT_DISTANCE
List<Order> supplementOrders = new ArrayList<>();
int accumulated = 0;
Store lastPlannedStore = null;
if (!warehouse.pendingStores.isEmpty()) {
    lastPlannedStore = warehouse.pendingStores.get(warehouse.pendingStores.size() - 1);
}

for (Store s : candidates) {
    if (lastPlannedStore != null) {
        double dx = s.getX() - lastPlannedStore.getX();
        double dy = s.getY() - lastPlannedStore.getY();
        double distance = Math.hypot(dx, dy)*KM_PER_PX;
        if (distance > MAX_SUPPLEMENT_DISTANCE) {
            continue;
        }
    }

    // 4) Bu mağaza için tüm depolardaki bekleyen siparişlerden, ihtiyaca kadar al
    for (Warehouse w : warehouses) {
        for (Order o : w.orderQueue) {
            if (o.store == s) {
                int remainingNeed = neededQuantity - accumulated;
                if (remainingNeed <= 0) {
                    return supplementOrders;
                }
                int take = Math.min(o.quantity, remainingNeed);
                if (take <= 0) continue;

                // Not: Burada orderQueue’dan silmiyoruz; dispatchTruck ekledikten sonra remove yapılmalı
                Order partial = new Order(o.store, o.productType, take, o.warehouse);
                supplementOrders.add(partial);
                accumulated += take;

                if (accumulated >= neededQuantity) {
                    return supplementOrders;
                }
            }
        }
    }
}
return supplementOrders;

]]></Body>
				</Function>
