					<Parameters>
						<Parameter>
							<Name><![CDATA[onEnter]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[// --- Agent reference
MultiStopTruck t = (MultiStopTruck) agent;

// --- Resolve the truck's display code (plate). Fallback to numeric ID if missing.
String truckCode = null;
// Prefer Main's mapping if present
if (get_Main().truckCodeMap != null) {
    truckCode = get_Main().truckCodeMap.get(t);
}
// Or, if the agent has its own plate field, prefer that:
// if (t.plateCode != null && !t.plateCode.isEmpty()) truckCode = t.plateCode;

if (truckCode == null || truckCode.isEmpty()) {
    truckCode = String.valueOf(t.truckID); // fallback to numeric id
}

// --- Compute travel time from distance + service (minutes in CSV, hours in memory)
// IMPORTANT: Ensure serviceTimePerStop is in MINUTES. If it is in HOURS, multiply by 60.
double speedKph = get_Main().TRUCK_SPEED_KPH;               // e.g., 110 KPH
double servicePerStop_min = get_Main().serviceTimePerStop;  // minutes per stop
int stops = (t.visitedStores != null) ? t.visitedStores.size() : 0;

double driveTime_min   = (t.totalDistance / speedKph) * 60.0;     // distance-based drive time
double serviceTime_min = stops * servicePerStop_min;               // total service time
double totalTravelTime_min = driveTime_min + serviceTime_min;      // minutes

// Keep in-memory metric in HOURS for backward compatibility
t.totalTravelTime = totalTravelTime_min / 60.0; // hours

// --- Build visited store list as comma-separated (null-safe)
String visited = "";
if (t.visitedStores != null) {
    for (Store s : t.visitedStores) {
        visited += "Store " + s.storeID + ", ";
    }
}
if (!visited.isEmpty()) {
    visited = visited.substring(0, visited.length() - 2); // remove trailing ", "
}

// --- Format dispatch date using model's calendar time
// Converts model time (hours since experiment start) to a real Date based on Initial date.
Date dispatchDateObj = timeToDate(t.dispatchDate);

// Example format: "dd/MM/yyyy, Friday"
java.text.SimpleDateFormat fmt = new java.text.SimpleDateFormat("dd/MM/yyyy, EEEE");
fmt.setTimeZone(java.util.TimeZone.getTimeZone("Europe/Berlin"));
String formattedDispatchDate = fmt.format(dispatchDateObj);

// --- Append TruckStats record (keeps numeric id internally if constructor expects it)
get_Main().truckStatsTable.add(
  new TruckStats(
    t.truckID,
    formattedDispatchDate,
    t.totalDistance,
    t.totalUnits,
    t.totalWeight,
    t.fuelCost,
    t.co2Emissions,
    t.totalTravelTime,  // hours
    visited,
    ((double) t.totalUnits / get_Main().truckCapacity) * 100.0 // fill rate (%)
  )
);

// --- Write CSV: FIRST COLUMN IS THE TRUCK CODE (string)
// NOTE: String.format uses the default Locale. If you need dot decimals, use String.format(Locale.US, ...).
get_Main().writeToCSV(
  String.format(
    "%s;%s;%.2f;%d;%.2f;%.2f;%.2f;%.2f;\"%s\";\"%s\";\"%s\"",
    truckCode,                                            // first column: plate/code
    formattedDispatchDate,
    t.totalDistance,
    t.totalUnits,
    t.totalWeight,
    t.fuelCost,
    t.co2Emissions,
    totalTravelTime_min,                                  // minutes in CSV
    visited,
    t.plannedStoresStr != null ? t.plannedStoresStr : "",
    t.supplementStoresStr != null ? t.supplementStoresStr : ""
  ),
  "trucks.csv"
);

// --- Log
traceln("Truck " + truckCode + " reported. Distance: " + t.totalDistance
        + " km | Travel Time (min): " + String.format("%.2f", totalTravelTime_min)
        + " | Dispatch: " + formattedDispatchDate);
]]></Code>
							</Value>
