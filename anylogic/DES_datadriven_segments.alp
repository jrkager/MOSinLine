				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1755466854215</Id>
					<Name><![CDATA[expectedDemandUntilNext]]></Name>
					<X>1090</X><Y>170</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[s]]></Name>
						<Type><![CDATA[Store]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[productType]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[currentDay]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[int days = daysUntilNextDelivery(s, currentDay); // 0..6 (plan yoksa 7)
double mu = 0.0;
for (int k = 0; k < days; k++) {
    int dayIdx = ((currentDay - 1 + k) % 7) + 1; // 1..7
    mu += getLambda(dayIdx, s.storeID, productType);
}
return mu;]]></Body>
