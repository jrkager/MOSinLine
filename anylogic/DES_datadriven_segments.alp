				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1755449415973</Id>
					<Name><![CDATA[exportPlannedSummaryToCSV]]></Name>
					<X>1720</X><Y>640</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[fileName]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[dayIdx]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[// dayIdx → gün adı
String[] dayNames = { "Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday" };
String dayName = dayNames[ ((dayIdx - 1) % 7 + 7) % 7 ];

// store bazında A,B,C sayımlarını hazırla
java.util.Map<Integer, int[]> agg = new java.util.HashMap<>();
for (DemandSpec d : plannedDemands) {
    int[] arr = agg.get(d.storeID);
    if (arr == null) {
        arr = new int[3];
        agg.put(d.storeID, arr);
    }
    int idx = prodIdx(d.productType); // 0=A,1=B,2=C
    arr[idx]++;
}

// tüm store’lar için satır yaz (yoksa 0 yazılır)
for (int s = 0; s < stores.size(); s++) {
    int[] arr = agg.get(s);
    int a = (arr == null) ? 0 : arr[0];
    int b = (arr == null) ? 0 : arr[1];
    int c = (arr == null) ? 0 : arr[2];
    String storeName = "Store " + s;

    // Day;Store;DemandA;DemandB;DemandC
    String line = time() + ";" + storeName + ";" + a + ";" + b + ";" + c;
    writeToCSV(line, fileName);
}
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1755460162870</Id>
					<Name><![CDATA[reportWeeklyStockout]]></Name>
					<X>1720</X><Y>500</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double currentTime = time();
int weekNumber = (int)(currentTime / (24 * 7));

if (!stockoutHeaderWritten) {
    writeToCSV("WeekNumber;Time;StoreID;LostTotal;LostA;LostB;LostC;LostCost",
               "WeeklyStockoutReport.csv");
    stockoutHeaderWritten = true;
}

for (Store s : stores) {
    int dLostTotal = s.lostDemandTotal - s.prevLostDemandTotal;
    int dLostA     = s.lostDemandA     - s.prevLostDemandA;
    int dLostB     = s.lostDemandB     - s.prevLostDemandB;
    int dLostC     = s.lostDemandC     - s.prevLostDemandC;

    double lostCost = dLostA * stockoutCostA
                    + dLostB * stockoutCostB
                    + dLostC * stockoutCostC;

    String line = weekNumber + ";" +
                  currentTime + ";" +
                  s.storeID + ";" +
                  dLostTotal + ";" +
                  dLostA + ";" +
                  dLostB + ";" +
                  dLostC + ";" +
                  lostCost;

    writeToCSV(line, "WeeklyStockoutReport.csv");

    // prev'leri güncelle
    s.prevLostDemandTotal = s.lostDemandTotal;
    s.prevLostDemandA     = s.lostDemandA;
    s.prevLostDemandB     = s.lostDemandB;
    s.prevLostDemandC     = s.lostDemandC;
}]]></Body>
				</Function>
