							<Code><![CDATA[MultiStopTruck]]></Code>
						</GenericParameterSubstituteValue>
					</GenericParameterSubstitute>
					<Parameters>
						<Parameter>
							<Name><![CDATA[type]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[delayTime]]></Name>
							<Value Class="CodeUnitValue">
								<Code><![CDATA[0]]></Code>
								<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
							</Value>
						</Parameter>
						<Parameter>
							<Name><![CDATA[capacity]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[maximumCapacity]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[true]]></Code>
							</Value>
						</Parameter>
						<Parameter>
							<Name><![CDATA[entityLocation]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[pushProtocol]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[restoreEntityLocationOnExit]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[forceStatisticsCollection]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onEnter]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onAtExit]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onExit]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[MultiStopTruck t = (MultiStopTruck) agent;

Store nextStore = t.routeStores.get(t.currentStopIndex);

double dx = nextStore.getX() - t.getX();
double dy = nextStore.getY() - t.getY();
double distance = Math.hypot(dx, dy)*get_Main().KM_PER_PX;

t.totalDistance += distance;

// 💡 Bu noktada mesafe zaten hesaplanmıştı
double segmentMass = t.currentWeight + get_Main().TRUCK_EMPTY_WEIGHT;

t.fuelCost += distance * segmentMass * get_Main().COST_PER_KG_KM
            + distance * 1.12;   // + c_km distance cost (driver/wear/tolls), aligned with ALNS c_km=1.12 EUR/km
t.co2Emissions += distance * segmentMass * get_Main().CO2_PER_KG_KM_GRAMS;

traceln("🧮 Segment: " + distance + " km | Ağırlık: " + segmentMass +
        " kg → Fuel: " + (distance * segmentMass * get_Main().COST_PER_KG_KM) +
        " | CO₂: " + (distance * segmentMass * get_Main().CO2_PER_KG_KM_GRAMS));
]]></Code>
							</Value>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onRemove]]></Name>
						</Parameter>
