						<Parameter>
							<Name><![CDATA[speed]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[restoreSpeedOnArrival]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onEnter]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onExit]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[MultiStopTruck t = (MultiStopTruck) agent;

// Son ziyaret edilen mağaza (rotanın sonu)
Store lastStore = (t.routeStores != null && !t.routeStores.isEmpty())
    ? t.routeStores.get(t.routeStores.size() - 1)
    : null;

// Döneceği depo
Warehouse wh = t.startWarehouse;

// Güvenlik kontrolleri
if (lastStore != null && wh != null) {
    // Model koordinatlarından km'ye: KM_PER_PX zaten Main'de parametre
    double dx = wh.getX() - lastStore.getX();
    double dy = wh.getY() - lastStore.getY();
    double returnDist_km = Math.hypot(dx, dy) * get_Main().KM_PER_PX;

    // Boş dönüş: yalnızca kamyon boş ağırlığı
    double emptyMass_kg = get_Main().TRUCK_EMPTY_WEIGHT;

    // Toplamlara ekle
    t.totalDistance  += returnDist_km;
    t.fuelCost       += returnDist_km * emptyMass_kg * get_Main().COST_PER_KG_KM
                      + returnDist_km * 1.12;   // + c_km on the empty return leg as well
    t.co2Emissions   += returnDist_km * emptyMass_kg * get_Main().CO2_PER_KG_KM_GRAMS;

    traceln(String.format(
        "Empty-return added: %.2f km | fuel=%.4f | CO2=%.4f",
        returnDist_km,
        returnDist_km * emptyMass_kg * get_Main().COST_PER_KG_KM,
        returnDist_km * emptyMass_kg * get_Main().CO2_PER_KG_KM_GRAMS
    ));
}

// Mevcut log
String truckCode = get_Main().truckCodeMap.get(t);
traceln("Truck [" + truckCode + "] returned to Warehouse " + t.startWarehouse + " and is now removed.");
]]></Code>
							</Value>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onRemove]]></Name>
						</Parameter>
					</Parameters>
