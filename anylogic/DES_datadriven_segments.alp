							<Value Class="CodeValue">
								<Code><![CDATA[MultiStopTruck truck = (MultiStopTruck) agent;

// 🚚 Doğru sipariş ve mağaza listesini sırayla al
List<Order> orderBatch = get_Main().truckOrderQueue.remove(0);
List<Store> storeBatch = get_Main().truckStoreQueue.remove(0);

truck.ordersToDeliver = orderBatch;
truck.routeStores = storeBatch;
truck.plannedStoresStr = get_Main().truckPlannedStoreStrQueue.remove(0);
truck.supplementStoresStr = get_Main().truckSupplementStoreStrQueue.remove(0);
truck.currentStopIndex = 0;
truck.startWarehouse = this;

truck.setXY(this.getX(), this.getY());
get_Main().dispatchedTrucks.add(truck);

// 📌 Raporlama için eklenenler
truck.truckID = get_Main().nextTruckID++;
truck.dispatchDate = time(); // Simülasyon zamanı (saat cinsinden)

// 🗓️ Simülasyon zamanını tarih formatına çevir
Date dispatchDateObj = new Date((long)(truck.dispatchDate * 3600 * 1000));
Calendar cal = Calendar.getInstance();
cal.setTime(dispatchDateObj);
int day = cal.get(Calendar.DAY_OF_MONTH);
int month = cal.get(Calendar.MONTH) + 1;
int year = cal.get(Calendar.YEAR);
String[] dayNames = { "Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday" };
String dayName = dayNames[cal.get(Calendar.DAY_OF_WEEK) - 1];
String formattedDispatchDate = String.format("%02d/%02d/%04d, %s", day, month, year, dayName);
traceln("🕒 Dispatch date: " + formattedDispatchDate);

// 🚛 Rastgele alfasayısal kod oluştur
String letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
String digits = "0123456789";
String truckCode =
    "" +
    letters.charAt((int)(uniform(0, 1) * letters.length())) +
    digits.charAt((int)(uniform(0, 1) * digits.length())) +
    letters.charAt((int)(uniform(0, 1) * letters.length()));
get_Main().truckCodeMap.put(truck, truckCode);

// 🔢 Ürün sayısı
int totalUnits = truck.ordersToDeliver.stream().mapToInt(o -> o.quantity).sum();
truck.totalUnits = totalUnits;

// 📦 Ağırlık hesaplamaları
truck.totalWeight = totalUnits * get_Main().PRODUCT_WEIGHT_KG + get_Main().TRUCK_EMPTY_WEIGHT;
truck.currentWeight = truck.totalUnits * get_Main().PRODUCT_WEIGHT_KG;

// 🖨️ Log
traceln("🚛 Truck created [" + truckCode + "]. Orders to deliver: " +
        truck.ordersToDeliver.size() + " orders, " + totalUnits + " total units");
traceln("🗺️ Route: " +
        truck.routeStores.stream().map(s -> "Store " + s.storeID).toList());
]]></Code>
							</Value>
						</Parameter>
