				<Event>
					<Id>1900000000010</Id>
					<Name><![CDATA[expireAndOrder]]></Name>
					<X>1720</X><Y>690</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[HOUR]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_HOUR]]></Unit>
						</Rate>
						<Id>1900000000011</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1740978000000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[5]]></Code>
							<Unit Class="TimeUnits"><![CDATA[HOUR]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[DAY]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[// ===== 05:00 daily: day-based expiry + order-up-to-S commitment (ALNS-faithful) =====
if (getCurrentDayIndex() != 1) {   // skip Sunday (6-day calendar): no working-day tick, no expiry/order
    simDay++;                       // advance working-day counter (Mon..Sat); first working day -> 0

    // (1) Day-based expiry of product A: a unit delivered on day d expires at start of day d+4 (4 days available)
    for (Store st : stores) {
        for (int k = st.stockA.size() - 1; k >= 0; k--) {
            if (st.stockA.get(k).expiryDay <= simDay) {
                st.stockA.remove(k);
                st.wasteCount  += 1;
                st.wasteCountA += 1;
            }
        }
    }

    // (2) Order-up-to-S PER PRODUCT for stores whose NEXT day is a delivery day (co-delivery:
    //     one pattern per store, all segments ship together, as in the segment-aware ALNS).
    //     ip_pre = on-hand AFTER today's expiry + today's incoming arrival, per product.
    int _dayIdx   = getCurrentDayIndex();      // Sun=1..Sat=7
    int _dppToday = _dayIdx - 2;               // Mon=0..Sat=5
    int _dppTom   = (_dppToday + 1) % 6;       // Sat(5) -> Mon(0)
    String[] _prods = { "A", "B", "C" };       // A=fresh, B=dry, C=frozen
    for (int _i = 0; _i < stores.size(); _i++) {
        for (int _p = 0; _p < 3; _p++) {
            if (plannedDeliveryQty[_i][_dppTom] > 0) {
                java.util.List<ProductUnit> _sl = (_p == 0) ? stores.get(_i).stockA
                                                : (_p == 1) ? stores.get(_i).stockB
                                                            : stores.get(_i).stockC;
                int _ip = _sl.size() + deliverTodayQty[_i][_p];
                double _mu = getLambda(_dayIdx, _i, _prods[_p]);
                pendingOrderQty[_i][_p] = Math.max(0, (int) Math.round(targetLevelS[_i][_p] - _ip + _mu));
            } else {
                pendingOrderQty[_i][_p] = 0;
            }
        }
    }

    // (3) Morning delivery: add today's incoming stock BEFORE the 08:00-17:00 demand window
    //     (ALNS deliver-then-consume). Truck travel/service is KPI-only and decoupled, because
    //     multi-stop trucks finish as late as ~22:00 and would otherwise starve late-route stores.
    for (int _j = 0; _j < stores.size(); _j++) {
        for (int _p = 0; _p < 3; _p++) {
            if (deliverTodayQty[_j][_p] > 0) {
                stores.get(_j).receiveDelivery(_prods[_p], deliverTodayQty[_j][_p]);
            }
        }
    }
}]]></Action>
				</Event>
				<Event>
					<Id>1754226670742</Id>
					<Name><![CDATA[reportStockLevels]]></Name>
					<X>1720</X><Y>720</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[HOUR]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_HOUR]]></Unit>
						</Rate>
						<Id>1741036279967</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1754294400000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[DAY]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[DAY]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[String[] dayNames = { "Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday" };
int currentDayIdx = getCurrentDayIndex();
String currentDayName = dayNames[currentDayIdx - 1];

for (Store s : stores) {
    for (String product : List.of("A", "B", "C")) {
        List<ProductUnit> stockList = product.equals("A") ? s.stockA :
                                      product.equals("B") ? s.stockB : s.stockC;

        int stockLevel = stockList.size();
        boolean stockout = stockLevel == 0;

        boolean pendingOrder = false;
        for (Order o : s.assignedWarehouse.orderQueue) {
            if (o.store == s && o.productType.equals(product)) {
                pendingOrder = true;
                break;
            }
        }

        int nextDel = getNextDeliveryDayIndex(s);
        double urgency = calculateUrgencyScore(s, product, currentDayIdx);

        String line = String.format("%.2f;%s;%d;%s;%d;%d;%d;%d;%.2f",
                        time(),
                        currentDayName,
                        s.storeID,
                        product,
                        stockLevel,
                        stockout ? 1 : 0,
                        pendingOrder ? 1 : 0,
                        nextDel,
                        urgency
        );

        writeToCSV(line, "StockLevelReport.csv");
    }
}
]]></Action>
				</Event>
				<Event>
					<Id>1755447026643</Id>
					<Name><![CDATA[generateDailyDemandPlan]]></Name>
					<X>1720</X><Y>750</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[HOUR]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_HOUR]]></Unit>
						</Rate>
						<Id>1741036279966</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1755504000000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[0]]></Code>
							<Unit Class="TimeUnits"><![CDATA[DAY]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[DAY]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[// ===== LEAD-1 shift: yesterday's committed order becomes today's actual arrival (delivery days only) =====
{
    int _dppToday = getCurrentDayIndex() - 2;   // Mon=0..Sat=5 ; Sun=-1
    for (int _i = 0; _i < stores.size(); _i++) {
        boolean _isDel = (_dppToday >= 0 && plannedDeliveryQty[_i][_dppToday] > 0);
        for (int _p = 0; _p < 3; _p++) deliverTodayQty[_i][_p] = _isDel ? pendingOrderQty[_i][_p] : 0;
        preStocked[_i] = false;   // same-day piggyback dedup flag, reset each morning
        if (ProductUnit.skippedTodayByStore != null) ProductUnit.skippedTodayByStore[_i] = false;   // Variant-4 registry, reset each morning
    }
    // NOTE: the old pre-stock-tomorrow piggyback (skip next-day delivery) is retired.
    // The Variant-1/4 piggyback is a same-day urgency top-up; no scheduled delivery is ever skipped by it.
}
// (order-up-to-S is committed in the 05:00 expireAndOrder event, after expiry + post-receive inventory)

// Günlük planı doldur
refillPlannedDemandsForToday();

// Planlanan talep adedi kadar ajanı Source'a enjekte et
int n = plannedDemands.size();
if (n > 0) {
    demandGeneration.inject(n); // demandGeneration: mevcut Source blok adınız
}
rebuildPlannedSummary();
exportPlannedSummaryToCSV("planned_demands.csv", getCurrentDayIndex());
reportUrgencyDebug();]]></Action>
				</Event>
				<Event>
					<Id>1755467737186</Id>
					<Name><![CDATA[routeDispatcher]]></Name>
					<X>1710</X><Y>90</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[HOUR]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_HOUR]]></Unit>
						</Rate>
						<Id>1741036279965</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1755504000000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[0]]></Code>
							<Unit Class="TimeUnits"><![CDATA[DAY]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[HOUR]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[int dayIdx = getCurrentDayIndex(); // 1..7
String[] dayNames = { "Sunday","Monday","Tuesday","Wednesday","Thursday","Friday","Saturday" };
String today = dayNames[dayIdx - 1];
double hourOfDay = time() % 24.0;

// Gün başında reset (sadece 00:00 ± bir saat aralığında bir kez)
if (hourOfDay < 1.0) {
    resetRoutesForToday();
}

// Planlanan saatine erişilen ve henüz sevk edilmemiş bugünkü rotaları sevk et
for (Route r : weeklyRoutes) {
    if (r.day.equals(today) && !r.dispatched && hourOfDay >= r.hour) {
        r.warehouse.dispatchRoute(r); // Adım 8’de eklediğin wrapper
    }
}]]></Action>
